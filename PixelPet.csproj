<!-- PixelPet.csproj - C# 專案檔（SDK 風格）
     用途：定義 C# 專案的編譯設定、依賴套件、目標框架。
     使用 .NET 8 + Windows Forms + WebView2。
     發佈指令：dotnet publish -c Release -p:PetLang=zh-TW -o publish/zh-TW -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <RootNamespace>PixelPet</RootNamespace>
    <Version>1.0.0</Version>
    <Company>PixelPet</Company>
    <Product>PixelPet</Product>
    <Description>Pixel Pet Simulator</Description>

    <!-- 語言由命令列 -p:PetLang=xx 決定，並寫進組件中繼資料。
         即使把 exe 改檔名，語言也不會變（不可改）。 -->
    <PetLang Condition="'$(PetLang)' == ''">zh-TW</PetLang>
    <AssemblyName>PixelPet-$(PetLang)</AssemblyName>

    <!-- 單檔發佈：managed DLL、WebView2 原生載入器、內嵌 www 全打包進單一 exe -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- NuGet 套件：WebView2 控制項 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- 把 www 全部檔案內嵌進 exe。
       LogicalName 保留相對路徑（例如 www/js/config.js），
       Program.cs 執行時依此解壓到本機快取資料夾。 -->
  <ItemGroup>
    <EmbeddedResource Include="www\**\*.*">
      <LogicalName>www/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 把該 exe 的固定語言寫進組件中繼資料，執行時由 Program.cs 讀取 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Lang</_Parameter1>
      <_Parameter2>$(PetLang)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
